# APP SETTINGS
APP_NAME=local
APP_PORT_SSL=8100
APP_PMA_PORT=8200
APP_PORT=8300
APP_DB_PORT=33070

# PHP VERSION
# Rebuild the web container after you change the PHP version:
# docker compose build
# docker compose up -d
APP_PHP_VERSION=8.4

# TIMEZONE
# https://www.php.net/manual/en/timezones.php
APP_TZ=Europe/Warsaw

# CONCRETE CMS INSTALLATION SETTINGS
INSTALL_SITE_NAME="REPLACE_WITH_YOUR_SITE_NAME"
INSTALL_ADMIN_EMAIL="REPLACE_WITH_YOUR_EMAIL"
INSTALL_ADMIN_PASSWORD="password"
INSTALL_LANGUAGE=pl_PL # Dashboard interface language
INSTALL_SITE_LOCALE=pl_PL # Default site language (first installed)
INSTALL_STARTING_POINT=theme # Choose from: theme, atomik_blank, atomik_full, elemental_full

# MYSQL SETTINGS
# Charset is also set in /docker/db/mariadb/my.cnf
DB_HOSTNAME=mariadb
DB_DATABASE=default
DB_USERNAME=root
DB_PASSWORD=root
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# USER SETTINGS
UID=1000
GID=1000

# MAILHOG SETTINGS
MAILHOG_ENABLED=1
MAILHOG_HTTP_PORT=8025
MAILHOG_SMTP_PORT=1025

# Declare the Concrete environment. This causes /application/config/{CONCRETE5_ENV}.database.php to be used.
CONCRETE5_ENV="live"
